# ==============================================================================
# DURGA BHAVANI SEVA SAMITI - DODLAPAHAD
# Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env in backend/ or frontend/ as appropriate.
# Never commit real credentials or secrets to version control.

# --- Backend Configuration ---
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas Free M0 cluster or local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/durga_bhavani_dodlapahad

# Session / JWT Authentication Secret (Generate a 64+ char random hex string in production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars

# Cloudinary Media Storage (Free tier credentials)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Super Admin Seed (Used strictly by scripts/seed-admin.ts)
INITIAL_ADMIN_NAME="Super Administrator"
INITIAL_ADMIN_EMAIL=admin@durgabhavani-dodlapahad.org
INITIAL_ADMIN_PASSWORD=change_this_temporary_secure_password_123!

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:5000/api/v1
